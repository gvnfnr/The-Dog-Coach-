{
        "version": 2,
        "builds": [
                    {
                                    "src": "index.html",
                                    "use": "@vercel/static"
                    },
                    {
                                    "src": "huncher.jpg",
                                    "use": "@vercel/static"
                    }
        ],
        "routes": [
                    {
                                    "src": "/huncher.jpg",
                                    "dest": "/huncher.jpg"
                    },
                    {
                                    "src": "/(.*)",
                                    "dest": "/index.html"
                    }
        ]
}
