{
          "version": 2,
          "builds": [
                    {
                              "src": "*.html",
                              "use": "@vercel/static"
                    },
                    {
                              "src": "*.jpg",
                              "use": "@vercel/static"
                    },
                    {
                              "src": "*.png",
                              "use": "@vercel/static"
                    }
          ],
          "routes": [
                    {
                              "src": "/huncher.jpg",
                              "dest": "/huncher.jpg"
                    },
                    {
                              "src": "/bulldog-hoodie.jpg",
                              "dest": "/bulldog-hoodie.jpg"
                    },
                    {
                              "src": "/LOGOFULL.png",
                              "dest": "/LOGOFULL.png"
                    },
                    {
                              "src": "/thedogcoach-favicon.png",
                              "dest": "/thedogcoach-favicon.png"
                    },
                    {
                              "src": "/how-it-works",
                              "dest": "/how-it-works.html"
                    },
                    {
                              "src": "/results-gallery",
                              "dest": "/results-gallery.html"
                    },
                    {
                              "src": "/pricing",
                              "dest": "/pricing.html"
                    },
                    {
                              "src": "/terms-of-service",
                              "dest": "/terms-of-service.html"
                    },
                    {
                              "src": "/privacy-policy",
                              "dest": "/privacy-policy.html"
                    },
                    {
                              "src": "/refund-policy",
                              "dest": "/refund-policy.html"
                    },
                    {
                              "src": "/(.*)",
                              "dest": "/index.html"
                    }
          ]
}
